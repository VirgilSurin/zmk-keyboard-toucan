/*
 * Toucan keymap: Colemak-DH
 *
 * Written with urob/zmk-helpers (https://github.com/urob/zmk-helpers).
 * The layer diagram in keymap-drawer/ is regenerated by GitHub Actions on every push.
 *
 * Key positions (42 keys, see zmk-helpers/key-labels/42.h):
 *
 *   LT5 LT4 LT3 LT2 LT1 LT0 │ RT0 RT1 RT2 RT3 RT4 RT5
 *   LM5 LM4 LM3 LM2 LM1 LM0 │ RM0 RM1 RM2 RM3 RM4 RM5
 *   LB5 LB4 LB3 LB2 LB1 LB0 │ RB0 RB1 RB2 RB3 RB4 RB5
 *               LH2 LH1 LH0 │ RH0 RH1 RH2
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

/* Layer indices (L_ prefix so they do not clash with the layer names). Must match the order of the ZMK_LAYER declarations below. */
#define L_BASE  0
#define L_NUM   1
#define L_SYM   2
#define L_ESYM  3
#define L_NAV   4
#define L_MOUSE 5
#define L_FN    6

/* ------------------------------------------------------------------------ */
/* Behavior tweaks                                                          */
/* ------------------------------------------------------------------------ */

&mt { flavor = "balanced"; };
&lt { flavor = "balanced"; };

/* ------------------------------------------------------------------------ */
/* Combos                                                                   */
/* ------------------------------------------------------------------------ */

/* Example (uncomment to use): press W+F together for Escape, on the base layer only.
 * ZMK_COMBO(combo_esc, &kp ESC, LT3 LT2, L_BASE)
 */

/* ------------------------------------------------------------------------ */
/* Layers                                                                   */
/* ------------------------------------------------------------------------ */

ZMK_LAYER(BASE,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &kp GRAVE     &kp Q           &kp W           &kp F           &kp P            &kp B             &kp J         &kp L            &kp U           &kp Y           &kp SEMICOLON   &kp SINGLE_QUOTE
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &caps_word    &mt LEFT_META A &mt LEFT_ALT R  &mt LCTRL S     &mt LEFT_SHIFT T &kp G             &kp M         &mt LEFT_SHIFT N &mt LCTRL E     &mt LEFT_ALT I  &mt LEFT_META O &sl L_ESYM  
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &kp LS(GRAVE) &kp Z           &kp X           &kp C           &kp D            &kp V             &kp K         &kp H            &kp COMMA       &kp DOT         &kp FSLH        &kp RIGHT_ALT
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &kp ESCAPE      &lt L_NAV SPACE  &lt L_MOUSE TAB   &lt L_SYM RET &lt L_NUM BSPC    &lt L_FN DEL
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(NUM,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &none         &kp LBKT        &kp N7          &kp N8          &kp N9           &kp RBKT          &studio_unlock &none          &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp SEMI        &kp N4          &kp N5          &kp N6           &kp EQUAL         &none         &kp LSHFT        &kp LCTRL       &kp LALT        &kp LGUI        &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp GRAVE       &kp N1          &kp N2          &kp N3           &kp BSLH          &none         &none            &none           &none           &none           &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &kp DOT         &kp N0           &kp MINUS         &none         &none            &none
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(SYM,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &none         &kp LS(LBRC)    &kp LS(AMPS)    &kp LS(STAR)    &kp LS(LPAR)     &kp LS(RBRC)      &none         &none            &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp LS(COLON)   &kp LS(DLLR)    &kp LS(PRCNT)   &kp LS(CARET)    &kp LS(PLUS)      &none         &kp LSHFT        &kp LCTRL       &kp LALT        &kp LGUI        &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp LS(TILDE)   &kp LS(EXCL)    &kp LS(AT)      &kp LS(POUND)    &kp LS(PIPE)      &none         &none            &none           &none           &none           &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &kp LS(LPAR)    &kp LS(RPAR)     &kp LS(UNDER)     &none         &none            &none
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(ESYM,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &none         &kp FSLH        &kp LS(COLON)   &kp LS(LBRC)    &kp LS(RBRC)     &none             &none         &none            &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp BSLH        &kp SEMI        &kp LS(LPAR)    &kp LS(RPAR)     &kp LS(DQT)       &none         &kp LS(LT)       &kp LS(GT)      &kp SEMI        &kp LS(COLON)   &to L_BASE
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp LS(PIPE)    &kp LS(COLON)   &kp LBKT        &kp RBKT         &kp SQT           &none         &none            &none           &none           &none           &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &kp LPAR        &kp RPAR         &kp UNDER         &none         &none            &none
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(NAV,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &none         &none           &none           &none           &none            &none             &none         &none            &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT        &none             &none         &kp LEFT         &kp DOWN        &kp UP          &kp RIGHT       &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &none           &none           &none           &none            &none             &kp INS       &kp HOME         &kp PG_DN       &kp PG_UP       &none           &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &none           &trans           &none             &none         &none            &none
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(MOUSE,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &none         &none           &none           &none           &none            &none             &none         &none            &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHFT        &none             &none         &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &none         &none           &none           &none           &none            &none             &none         &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &none           &none            &none             &mkp LCLK     &mkp RCLK        &mkp MCLK
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)

ZMK_LAYER(FN,
//╭─────────────┬───────────────┬───────────────┬───────────────┬────────────────┬─────────────╮ ╭─────────────┬────────────────┬───────────────┬───────────────┬───────────────┬──────────────────╮
    &bt BT_CLR_ALL &none          &kp F7          &kp F8          &kp F9           &kp F10           &none         &none            &none           &none           &none           &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &studio_unlock &none          &kp F4          &kp F5          &kp F6           &kp F11           &none         &kp C_VOL_DN     &kp K_PLAY_PAUSE &kp K_MUTE     &kp C_VOL_UP    &none
//├─────────────┼───────────────┼───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┼───────────────┼──────────────────┤
    &bt BT_NXT    &none           &kp F1          &kp F2          &kp F3           &kp F12           &none         &none            &none           &none           &none           &none
//╰─────────────┴───────────────┴───────────────┼───────────────┼────────────────┼─────────────┤ ├─────────────┼────────────────┼───────────────┼───────────────┴───────────────┴──────────────────╯
                                                  &none           &none            &none             &none         &none            &none
//                                              ╰───────────────┴────────────────┴─────────────╯ ╰─────────────┴────────────────┴───────────────╯
)
